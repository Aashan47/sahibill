# ~/sahibill/env on the server, mode 600. Never committed. One worker reads it at start.
NEBIUS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Total Nebius spend this server may make, in USD, counted from its own cost log. 0 serves saved readings only.
SAHIBILL_BUDGET_USD=0
# Site-wide ceilings per day.
SAHIBILL_MODAL_CALLS_PER_DAY=400
SAHIBILL_PHOTOS_PER_DAY=300
